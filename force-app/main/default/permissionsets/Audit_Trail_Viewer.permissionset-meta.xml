<?xml version="1.0" encoding="UTF-8" ?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Audit Trail Viewer</label>
    <description
    >Grants the Audit Trail Explorer app, tab, Apex classes, and read-only View Setup and Configuration (plus its View Roles prerequisite) needed to read SetupAuditTrail. Managed-package subscribers must also be granted View Setup separately.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <classAccesses>
        <apexClass>AuditQueryController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>AuditQueryService</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>AuditPermissionService</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>SetupAuditTrailProvider</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <applicationVisibilities>
        <application>Audit_Trail_Explorer</application>
        <visible>true</visible>
    </applicationVisibilities>
    <tabSettings>
        <tab>Audit_Trail_Explorer</tab>
        <visibility>Visible</visibility>
    </tabSettings>
    <userPermissions>
        <enabled>true</enabled>
        <name>ViewRoles</name>
    </userPermissions>
    <userPermissions>
        <enabled>true</enabled>
        <name>ViewSetup</name>
    </userPermissions>
</PermissionSet>
